extends Node
## The level's sound. Everything is generated by Sfx (no audio files).
##   always:        the building's low hum + a slow, wrong little tune from the songbook
##                  (songs.gd): each chapter starts on its own song, and every couple of
##                  minutes it fades out and the next one fades in
##   while hunted:  the music box stops, chase music + your heartbeat take over
##   you:           footsteps that match your walking, a thump when you land
##   events:        a chime when you find a toy, a scream when something SEES you,
##                  a screech when something GETS you
##   the building:  now and then something thuds, clacks or giggles somewhere off in the dark
##   hiding:        your heartbeat, if one of them is close to the cupboard - and everything
##                  outside sounds muffled through the doors
##   the room:      an echo sized to the chapter (the theme's "reverb": tight classroom, huge gym)
##   behind you:    sometimes whispering; sometimes a second set of footsteps that walks when
##                  you walk and stops a moment after you stop
##   hush(s):       everything but your heartbeat drains away for a moment (before a scare)

@export_group("Volumes (dB)")
@export var hum_db := -18.0
@export var music_db := -13.0
@export var panic_db := -6.0
@export var heartbeat_db := -4.0
@export var footstep_db := -9.0
@export var effects_db := 0.0
@export var ambience_db := -6.0

@export_group("Songs")
@export var song_length := 100.0   # seconds a song plays before the next one takes over
@export var song_fade := 5.0       # seconds to fade out, and to fade in
@export var song_gap := 3.0        # seconds of just the hum in between

const STRIDE := 1.7         # metres between footsteps

var _hum: AudioStreamPlayer
var _panic: AudioStreamPlayer
var _music: AudioStreamPlayer
var _steps: AudioStreamPlayer
var _fx: AudioStreamPlayer
var _ambient: AudioStreamPlayer3D

var _hunted := 0.0          # 0..1 eases in when a monster hunts you
var _beat_timer := 0.0
var _song := 0              # index into Songs.LIST
var _song_time := 0.0       # how long this song has been on
var _song_gain := 0.0       # 0..1, the fade between songs
var _note_index := 0
var _note_timer := 1.5
var _ambient_timer := 12.0
var _step_dist := 0.0
var _step_variant := 0
var _was_on_floor := true
var _prev_vy := 0.0
var _hush := 0.0            # seconds left of the hush before a scare
var _hush_gain := 1.0       # 1 = normal .. 0 = silent
var _muffle := 0.0          # 0 = open air .. 1 = inside a cupboard
var _reverb: AudioEffectReverb
var _lowpass: AudioEffectLowPassFilter
var _follower: AudioStreamPlayer3D
var _follow_for := 0.0      # seconds the footsteps behind you keep following
var _follow_in := 70.0      # ...until they start again
var _follow_queue: Array[float] = []   # echo steps waiting to land
var _was_walking := false


func _ready() -> void:
	_hum = _loop_player("hum", hum_db)
	_panic = _loop_player("panic", -60.0)
	_music = _poly_player(music_db, 12)   # bells and organ notes ring a long time
	_steps = _poly_player(footstep_db)
	_fx = _poly_player(effects_db)
	_ambient = AudioStreamPlayer3D.new()
	_ambient.volume_db = ambience_db
	_ambient.unit_size = 6.0
	_ambient.max_distance = 60.0
	add_child(_ambient)
	_follower = AudioStreamPlayer3D.new()
	_follower.unit_size = 4.0
	_follower.max_distance = 30.0
	_follower.volume_db = footstep_db - 2.0
	add_child(_follower)
	_set_up_bus()
	_follow_in = randf_range(50.0, 90.0)
	_start_song(Songs.for_chapter(Settings.chapter))
	Game.collected_one.connect(func(): _play(_fx, "chime"))
	Game.spotted.connect(func(_by: Node3D): _play(_fx, "scream"))
	Game.found.connect(func(_by: Node3D): _play(_fx, "scream", 2.0))
	Game.caught.connect(func(_by: Node3D): _play(_fx, "screech", 6.0))


func _process(delta: float) -> void:
	var hunted := false
	for m in get_tree().get_nodes_in_group("monster"):
		if m.chasing:
			hunted = true
			break
	_hunted = move_toward(_hunted, 1.0 if hunted else 0.0, delta * (3.0 if hunted else 0.4))
	_panic.volume_db = lerpf(-60.0, panic_db, sqrt(_hunted))
	_songbook(delta)
	_hush = maxf(_hush - delta, 0.0)
	_hush_gain = move_toward(_hush_gain, 0.0 if _hush > 0.0 else 1.0, delta * (1.5 if _hush > 0.0 else 0.5))
	_music.volume_db = lerpf(-60.0, music_db + Songs.LIST[_song].get("db", 0.0), _song_gain * (1.0 - _hunted) * _hush_gain)
	_hum.volume_db = lerpf(-50.0, hum_db, _hush_gain)
	_muffle = move_toward(_muffle, 1.0 if Game.hiding else 0.0, delta * 3.0)
	if _lowpass:
		_lowpass.cutoff_hz = lerpf(20000.0, 700.0, _muffle)

	# heartbeat: faster the more scared you are; slow and loud while you hide with one of them near
	var hiding_near := Game.hiding and _nearest_monster() < 9.0
	if _hunted > 0.01 or hiding_near:
		_beat_timer -= delta
		if _beat_timer <= 0.0:
			_beat_timer = 1.0 / lerpf(1.0, 2.8, _hunted)
			_play(_fx, "heart", heartbeat_db + lerpf(-3.0 if hiding_near else -10.0, 0.0, _hunted))

	# the building: something bumps, clacks or giggles in another room every so often
	_ambient_timer -= delta
	if _ambient_timer <= 0.0 and _hunted < 0.2 and not get_tree().paused:
		_ambient_timer = randf_range(9.0, 22.0)
		_far_noise()

	# the song: one note at a time, never quite in time
	_note_timer -= delta
	if _note_timer <= 0.0 and _hunted < 0.5 and _song_gain > 0.0:
		var song := Songs.LIST[_song]
		var melody := Songs.melody(_song)
		var bass := Songs.bass(_song)
		var beat: float = song["beat"]
		var swing: float = song.get("swing", 0.1)
		var miss: float = song.get("miss", 0.0)
		var f := melody[_note_index % melody.size()]
		_note_timer = beat * randf_range(1.0 - swing * 0.5, 1.0 + swing)
		if f > 0.0 and randf() >= miss:   # sometimes a tine is missing, a key sticks
			_play(_music, song["instrument"], randf_range(-3.0, 0.0), Songs.pitch(song["instrument"], f) * randf_range(0.995, 1.005))
		var bar: int = song.get("bar", 0)
		if bar > 0 and not bass.is_empty() and _note_index % bar == 0:
			var b := bass[(_note_index / bar) % bass.size()]
			if b > 0.0:
				_play(_music, song["bass_instrument"], -5.0, Songs.pitch(song["bass_instrument"], b))
		_note_index += 1

	_footsteps(delta)
	_follow(delta)


## Before a scare: drain the music and the hum away for a moment, so it lands in silence.
func hush(seconds: float) -> void:
	_hush = maxf(_hush, seconds)


## Echo and muffling live on the master bus (made in code, so there's no bus layout file).
## The room size comes from the chapter's theme.
func _set_up_bus() -> void:
	var bus := AudioServer.get_bus_index("Master")
	_reverb = null
	_lowpass = null
	for i in AudioServer.get_bus_effect_count(bus):
		var fx := AudioServer.get_bus_effect(bus, i)
		if fx is AudioEffectReverb:
			_reverb = fx
		elif fx is AudioEffectLowPassFilter:
			_lowpass = fx
	if _reverb == null:
		_reverb = AudioEffectReverb.new()
		AudioServer.add_bus_effect(bus, _reverb)
	if _lowpass == null:
		_lowpass = AudioEffectLowPassFilter.new()
		AudioServer.add_bus_effect(bus, _lowpass)
	var level := get_parent()
	var room: float = 0.4
	if level and "theme" in level:
		room = level.theme.get("reverb", 0.4)
	_reverb.room_size = room
	_reverb.damping = lerpf(0.7, 0.3, room)
	_reverb.wet = lerpf(0.12, 0.32, room)
	_reverb.dry = 1.0
	_reverb.predelay_msec = lerpf(20.0, 90.0, room)
	_lowpass.cutoff_hz = 20000.0


## Something walks behind you, in step with you - and stops just after you do.
func _follow(delta: float) -> void:
	var players := get_tree().get_nodes_in_group("player")
	if players.is_empty() or get_tree().paused:
		return
	var p: CharacterBody3D = players[0]
	if _follow_for <= 0.0:
		_follow_in -= delta
		if _follow_in <= 0.0 and _hunted < 0.1:
			_follow_for = randf_range(8.0, 14.0)
			_follow_in = randf_range(70.0, 140.0)
	else:
		_follow_for -= delta
	for i in range(_follow_queue.size() - 1, -1, -1):
		_follow_queue[i] -= delta
		if _follow_queue[i] <= 0.0:
			_follow_queue.remove_at(i)
			var cam := get_viewport().get_camera_3d()
			var back := cam.global_basis.z if cam else Vector3.BACK
			back.y = 0.0
			_follower.global_position = p.global_position + back.normalized() * randf_range(3.5, 5.0) + Vector3.UP * 0.2
			_follower.stream = Sfx.get_sound("step%d" % (randi() % 4))
			_follower.pitch_scale = randf_range(0.7, 0.8)
			_follower.play()
	var walking: bool = (p.active if "active" in p else true) and Vector2(p.velocity.x, p.velocity.z).length() > 1.0
	if _was_walking and not walking and _follow_for > 0.0:
		_follow_queue.append(0.55)   # ...one more step after you stop. Then nothing.
	_was_walking = walking


## Called for each of your footsteps: while it follows you, it steps a beat behind.
func _echo_step() -> void:
	if _follow_for > 0.0:
		_follow_queue.append(randf_range(0.22, 0.3))


## Songs take turns: play, fade out, a few seconds of nothing but the hum, the next one fades in.
func _songbook(delta: float) -> void:
	_song_time += delta
	if _song_time < song_length:
		_song_gain = move_toward(_song_gain, 1.0, delta / song_fade)
	elif _song_time < song_length + song_fade + song_gap:
		_song_gain = move_toward(_song_gain, 0.0, delta / song_fade)
	else:
		_start_song(Songs.next(_song))


func _start_song(index: int) -> void:
	_song = index
	_song_time = 0.0
	_song_gain = 0.0
	_note_index = 0
	_note_timer = 0.5


## What's on right now (for the tests and for the curious).
func song_name() -> String:
	return Songs.LIST[_song]["name"]


## How far the closest monster is from you (INF if there's nobody).
func _nearest_monster() -> float:
	var players := get_tree().get_nodes_in_group("player")
	if players.is_empty():
		return INF
	var p: Node3D = players[0]
	var nearest := INF
	for m in get_tree().get_nodes_in_group("monster"):
		nearest = minf(nearest, m.global_position.distance_to(p.global_position))
	return nearest


## A distant sound from a random direction, 8-16 m away: a thud, a door, a clack, rarely a giggle.
func _far_noise() -> void:
	var players := get_tree().get_nodes_in_group("player")
	if players.is_empty():
		return
	var p: Node3D = players[0]
	var angle := randf() * TAU
	var dist := randf_range(8.0, 16.0)
	_ambient.global_position = p.global_position + Vector3(cos(angle) * dist, 1.0, sin(angle) * dist)
	var roll := randf()
	if roll > 0.88:
		# a whisper, close behind you
		var cam := get_viewport().get_camera_3d()
		var back := cam.global_basis.z if cam else Vector3.BACK
		back.y = 0.0
		_ambient.global_position = p.global_position + back.normalized() * randf_range(1.5, 2.5) + Vector3(randf_range(-1.0, 1.0), 1.4, 0.0)
		_ambient.stream = Sfx.get_sound("whisper")
		_ambient.pitch_scale = randf_range(0.85, 1.05)
		_ambient.play()
		return
	var sound := "thud"
	var pitch := randf_range(0.5, 0.7)
	if roll < 0.3:
		sound = "clack"
		pitch = randf_range(0.7, 0.9)
	elif roll < 0.5:
		sound = "door"
		pitch = randf_range(0.6, 0.8)
	elif roll < 0.58:
		sound = "giggle"
		pitch = randf_range(0.85, 1.0)
	_ambient.stream = Sfx.get_sound(sound)
	_ambient.pitch_scale = pitch
	_ambient.play()


func _footsteps(delta: float) -> void:
	var players := get_tree().get_nodes_in_group("player")
	if players.is_empty() or get_tree().paused:   # the music keeps going on the menus; feet don't
		return
	var p: CharacterBody3D = players[0]
	var on_floor := p.is_on_floor()
	if on_floor and not _was_on_floor and _prev_vy < -4.0:
		_play(_steps, "land", 0.0, randf_range(0.9, 1.1))
		_step_dist = STRIDE * 0.5
	_was_on_floor = on_floor
	_prev_vy = p.velocity.y

	var walking: bool = p.active if "active" in p else true
	var speed := Vector2(p.velocity.x, p.velocity.z).length()
	if walking and on_floor and speed > 1.0:
		_step_dist += speed * delta
		if _step_dist >= STRIDE:
			_step_dist = 0.0
			_step_variant = (_step_variant + 1 + randi() % 3) % 4
			_play(_steps, "step%d" % _step_variant, randf_range(-3.0, 0.0), randf_range(0.9, 1.12))
			_echo_step()
	else:
		_step_dist = STRIDE * 0.7   # first step comes quickly when you start walking


func _play(player: AudioStreamPlayer, sound: String, db := 0.0, pitch := 1.0) -> void:
	var pb := player.get_stream_playback() as AudioStreamPlaybackPolyphonic
	if pb == null:
		return
	pb.play_stream(Sfx.get_sound(sound), 0.0, db, pitch)


func _loop_player(sound: String, db: float) -> AudioStreamPlayer:
	var player := AudioStreamPlayer.new()
	player.stream = Sfx.get_sound(sound)
	player.volume_db = db
	player.autoplay = true
	add_child(player)
	return player


func _poly_player(db: float, voices := 8) -> AudioStreamPlayer:
	var player := AudioStreamPlayer.new()
	var poly := AudioStreamPolyphonic.new()
	poly.polyphony = voices
	player.stream = poly
	player.volume_db = db
	player.autoplay = true
	add_child(player)
	return player
