[sub_resource type="Shader" id="Shader_vignette"]
code = "shader_type canvas_item;
// Dark red creeping in from the edges. strength 0 = nothing, 1 = you're about to die.
uniform float strength : hint_range(0.0, 1.0) = 0.0;

void fragment() {
	vec2 d = UV - vec2(0.5);
	float v = smoothstep(0.12, 0.72, length(d) * 1.35);
	COLOR = vec4(0.45, 0.0, 0.0, v * strength);
}"

